#!/usr/bin/nft -f

include "./data/var.nft"

table inet wg.domestic
delete table inet wg.domestic
table inet wg.domestic {
    set v4 {
        type ipv4_addr
        flags constant, interval
        elements = $IPV4_ELEMENTS
    }

    set v6 {
        type ipv6_addr
        flags constant, interval
        elements = $IPV6_ELEMENTS
    }

    # 创建一个用于 MSS Clamping 的新链
    chain clamp_mss {
        comment "MSS Clamping Chain" ;
        # 仅匹配 TCP 协议的 SYN 包（连接建立的第一个包）
        tcp flags & (fin|syn|rst|ack) == syn \
        # 将 MSS 值钳制在 wg0 的 MTU (1280) 减去 IP/TCP 头部大小 (40+20=60 for IPv4, 60+20=80 for IPv6)
        # 为了安全起见，我们用 1280 - 80 = 1200
        counter tcp option maxseg size set rt mtu
    }

    chain try_restore_mark {
        ct mark & $FWMARK == $FWMARK meta mark set ct mark
        ct mark & $FWMARK != $FWMARK ip daddr != @v4 meta mark set mark | $FWMARK
        ct mark & $FWMARK != $FWMARK ip6 daddr != @v6 meta mark set mark | $FWMARK
    }

    chain try_save_mark {
        ct mark & $FWMARK != $FWMARK meta mark & $FWMARK == $FWMARK ct mark set meta mark
    }

    chain filter.prerouting.mangle {
        type filter hook prerouting priority mangle
        #meta nftrace set 1

        jump try_restore_mark
    }

    chain route.output.mangle {
        type route hook output priority mangle
        #meta nftrace set 1

        jump try_restore_mark
    }

    chain filter.forward.mangle {
        type filter hook forward priority mangle + 1;
        meta mark & $FWMARK == $FWMARK counter jump clamp_mss
    }

    chain filter.output.mangle {
        type filter hook output priority mangle + 1;
        meta mark & $FWMARK == $FWMARK counter jump clamp_mss
    }

    chain filter.postrouting.mangle {
        type filter hook postrouting priority mangle
        #meta nftrace set 1

        jump try_save_mark
    }

    chain nat.postrouting.srcnat {
        type nat hook postrouting priority srcnat
        #meta nftrace set 1

        meta mark & $FWMARK == $FWMARK masquerade
    }
}
